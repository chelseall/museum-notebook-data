,1810,0,0,null,0,"9/99/Baron_Antoine-Jean_Gros-Battle_Pyramids_1810.jpg/330px-Baron_Antoine-Jean_Gros-Battle_Pyramids_1810.jpg",0,0,1,5,4],[131353884,"Interview Between Napoleon and Francis II after the Battle of Austerlitz",1812,0,0,null,0,"b/bf/Gros_-_Entrevue_-_1812.jpg/330px-Gros_-_Entrevue_-_1812.jpg",0,0,1,1,4],[131624690,"Portrait du comte Honoré de La Riboisière (1788-1868)",1815,0,0,null,0,"8/8c/Gros_-_Portrait_du_comte_Honor%C3%A9_de_La_Riboisi%C3%A8re_%281788-1868%29.jpg/330px-Gros_-_Portrait_du_comte_Honor%C3%A9_de_La_Riboisi%C3%A8re_%281788-1868%29.jpg",0,0,1,0,null],[132730071,"Presumed portrait of Jean Vasserot",1850,0,0,null,0,"6/68/Presumed_portrait_of_Jean_Vasserot_%281769-1837%29_by_Antoine-Jean_Gros.jpg/330px-Presumed_portrait_of_Jean_Vasserot_%281769-1837%29_by_Antoine-Jean_Gros.jpg",0,0,1,0,null],[134881436,"Eleazar préfère la mort",1792,0,0,null,0,"8/8b/Eleazar_pr%C3%A9f%C3%A8re_la_mort_-_Antoine-Jean_Gros_-_MM_1938F478.jpg/330px-Eleazar_pr%C3%A9f%C3%A8re_la_mort_-_Antoine-Jean_Gros_-_MM_1938F478.jpg",0,0,1,0,60],[138770910,"The battle of Laubressel, near Troyes, March 3, 1814",1830,0,0,null,0,"0/09/Combat_de_Laubressel.jpg/330px-Combat_de_Laubressel.jpg",0,0,1,0,58],[138800628,"Painting by Antoine-Jean Gros",1812,0,0,null,0,"4/47/Comtesse_de_Lasalle_et_de_sa_fille.jpg/330px-Comtesse_de_Lasalle_et_de_sa_fille.jpg",0,0,1,0,58],[140698651,"Etienne-Jacques-Joseph MacDonald, duc de Tarente, maréchal de France (1765-1840)",1817,0,0,null,0,"2/24/MacDonald_par_Antoine_Jean_Gros.jpg/330px-MacDonald_par_Antoine_Jean_Gros.jpg",0,0,1,1,4]],"summaryBase":"https://en.wikipedia.org/wiki/","summaryLicence":"CC BY-SA 4.0","summaries":{"1282978":["Bonaparte at the Pont d’Arcole is an oil-on-canvas painting executed in 1796 by the French artist Antoine-Jean Gros. It depicts an episode during the Battle of Arcole in November 1796, with General Napoleon Bonaparte leading his troops to storm the bridge.","Bonaparte at the Pont d'Arcole"],"2889459":["The Battle of Nazareth is an oil on canvas painting by French painter Antoine-Jean Gros, from 1801. It represents the French Army, led by General Andoche Junot, in a battle where he defeated the Ottoman army during the Egyptian campaign of Napoleon.","The Battle of Nazareth (Gros)"],"2909905":["Bonaparte, First Consul is an oil painting on canvas by French painter Antoine-Jean Gros, from 1802, which is a full-length portrait of Napoleon Bonaparte as First Consul. The painting was commissioned by Napoleon himself who offered it to Jean-Jacques-Régis de Cambacérès, the Second Consul.","Bonaparte, First Consul (Gros)"],"2909916":["Bonaparte Visits the Plague Victims of Jaffa is a propagandistic, oil-on-canvas painting commissioned by Napoleon and painted in 1804 by Antoine-Jean Gros, portraying an event during the French invasion of Egypt and Syria.","Bonaparte Visiting the Plague Victims of Jaffa"],"3206488":["The Battle of Aboukir is an oil-on-canvas painting by Antoine-Jean Gros. Commissioned by Joachim Murat in 1805, it was completed in 1806.","The Battle of Aboukir"],"3335976":["Napoleon on the Battlefield of Eylau is an oil painting of 1808 by French Romantic painter Antoine-Jean Gros. Completed during the winter of 1807–1808, the work became an icon of the emerging style of French Romanticism.","Napoleon on the Battlefield of Eylau"],"17582425":["Hercules and Diomedes is an 1835 oil painting by the French artist Antoine-Jean Gros. It depicts two figures from Ancient Greek Mythology, Heracles and Diomedes.","Hercules and Diomedes"],"17652079":["Sappho at Leucate, also known as The Death of Sappho, is an oil-on-canvas painting executed by the French artist Antoine-Jean Gros in 1801. It measures 122 x 100 cm and is held in the Musée d'Art et d'Histoire Baron-Gérard, in Bayeux.","Sappho at Leucate"],"18762443":["Portrait of Christine Boyer is an 1800 oil-on-canvas portrait painting by the French artist Antoine-Jean Gros. It depicts Christine Boyer, the first wife of Lucien Bonaparte.","Portrait of Christine Boyer"],"18818939":["The Embarkation of the Duchess of Angoulême at Pauillac is an 1818 history painting by the French artist Antoine-Jean Gros. Gros had made his reputation depicting scenes of Napoleon Bonaparte and the French Empire.","The Embarkation of the Duchess of Angoulême at Pauillac"],"20267710":["Portrait of the Maistre Sisters is a 1796 oil-on-canvas portrait painting by the French artist Antoine-Jean Gros. Gros, a former pupil of Jacques-Louis David, became known for his history paintings blending neoclassicism and romanticism.","Portrait of the Maistre Sisters"],"22670982":["Portrait of Madame Recamier is an oil on canvas painting by French artist Antoine-Jean Gros from about 1825. It is held at the Strossmayer Gallery of Old Masters, in Zagreb.","Portrait of Madame Récamier (Gros)"],"22811640":["Bacchus and Ariadne is an 1820 oil painting by the French artist Antoine-Jean Gros. Drawing on the traditions of the history painting, it depicts the mythological Ancient Greek figures Bacchus and Ariadne.","Bacchus and Ariadne (Gros)"],"29855502":["The Equestrian Portrait of Joachim Murat, King of Naples is an oil on canvas painting by the French neoclassical and pre-romantic painter Antoine-Jean Gros, created c. 1808-1812. It is held at the Louvre, in Paris.","Equestrian Portrait of Joachim Murat, King of Naples"],"59248125":["Napoleon Accepting the Surrender of Madrid is an 1810 history painting by the French artist Antoine-Jean Gros. It depicts Napoleon, Emperor of France, accepting the capitulation of Madrid, on 4 December 1808, during the Peninsular War.","Napoleon Accepting the Surrender of Madrid"],"59248135":["Portrait of the Duchess of Angoulême is an 1816 portrait painting by the French artist Antoine-Jean Gros depicting Marie Thérèse of France. The only surviving child of the guillotined Louis XVI she returned to France following the defeat of Napoleon.","Portrait of the Duchess of Angoulême"],"60469449":["Portrait of Jean-Antoine Chaptal is an 1824 portrait painting by the French artist Antoine-Jean Gros. It depicts the French scientist and politician Jean-Antoine Chaptal who served as Minister of the Interior from 1800 to 1804 during the French Consulate.","Portrait of Jean-Antoine Chaptal"],"130481897":["General Lasalle at the Siege of Stettin is an 1808 portrait painting by the French artist Antoine-Jean Gros. Combining portraiture with elements of history painting it depicts Antoine Charles Louis de Lasalle against the backdrop of the Siege of Stettin during the Napoleonic Wars.","General Lasalle at the Siege of Stettin"],"130633519":["The Battle of the Pyramids is an oil on canvas history painting by the French artist Antoine-Jean Gros, frm 1810. It depicts the Battle of the Pyramids on 21 July 1798 during the French Invasion of Egypt.","The Battle of the Pyramids (painting)"],"131353884":["Interview Between Napoleon and Francis II after the Battle of Austerlitz is an 1812 history painting by the French artist Antoine-Jean Gros. It portrays the meeting of Napoleon, Emperor of France, and Francis II of Austria in the aftermath of the Battle of Austerlitz in December 1805.","Interview Between Napoleon and Francis II after the Battle of Austerlitz"]}}